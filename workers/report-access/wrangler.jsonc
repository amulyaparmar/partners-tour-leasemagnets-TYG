{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "partners-report-access",
  "main": "src/index.mjs",
  "compatibility_date": "2026-09-26",
  "account_id": "897eca458ed5541301ae936cf97c634b",
  "durable_objects": { "bindings": [{ "name": "ACCESS", "class_name": "ReportAccess" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ReportAccess"] }],
  "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["notifications@tour.report"] }],
  "vars": { "FROM_ADDRESS": "notifications@tour.report", "FROM_NAME": "Tour.report" },
  "observability": { "enabled": true }
}
